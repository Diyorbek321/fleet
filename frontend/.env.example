# Frontend environment variables.
#
# IMPORTANT: Vite inlines every VITE_* variable into the JS bundle at BUILD
# time (`npm run build`). They are NOT read at runtime, so changing them
# requires a rebuild. Never put secrets here — anything VITE_* is shipped to
# the browser and is publicly visible.

# Base URL of the backend HTTP API (required).
VITE_API_URL=http://localhost:8000

# Base URL of the backend WebSocket endpoint for live truck locations (required).
VITE_WS_URL=ws://localhost:8000
