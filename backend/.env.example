# ==== App ====
APP_NAME="Fleet Watch Pro API"
ENV=dev
DEBUG=true

# ==== Database ====
# Postgres (prod):  postgresql+asyncpg://user:password@host:5432/fleet
# SQLite (dev):     sqlite+aiosqlite:///./fleet.db
DATABASE_URL="postgresql+asyncpg://fleet:fleet@localhost:5432/fleet"

# ==== JWT ====
# Generate with:  python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY="CHANGE_ME_TO_A_LONG_RANDOM_STRING"
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ==== CORS ====
# Comma-separated list; no trailing slash. Use your prod domain in production.
CORS_ORIGINS="http://localhost:8080,http://localhost:5173,http://localhost:3000"

# ==== GPS ingestion ====
# Comma-separated API keys accepted at /api/gps endpoints
GPS_API_KEYS="replace-with-device-key-1,replace-with-device-key-2"

# ==== Redis ====
# Used for refresh-token revocation, rate-limit storage, and the scheduler lock.
# In production (ENV=prod) Redis is REQUIRED and enabled automatically so multiple
# workers/replicas share state — set REDIS_URL to a reachable instance.
REDIS_URL="redis://localhost:6379/0"
# Force Redis even outside prod (e.g. staging). Prod always uses Redis regardless.
USE_REDIS_REFRESH_TOKENS=false

# ==== Database connection pool (Postgres only; ignored for SQLite) ====
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

# ==== Observability ====
# Set to your Sentry DSN to enable error tracking. Leave blank to disable.
SENTRY_DSN=""

# ==== Background scheduler ====
SCHEDULER_ENABLED=true
SCHEDULER_INTERVAL_MINUTES=15

# ==== AI reports (optional; OpenAI-compatible) ====
AI_API_KEY=""
AI_BASE_URL="https://api.openai.com/v1"
AI_MODEL="gpt-4o-mini"

# ==== Tenant provisioning ====
# Self-service sign-up at POST /api/auth/register. OFF by default: this is a paid,
# operator-provisioned product, so an open endpoint would let anyone create a
# tenant. Turn on only for demo/staging. Disabled = the endpoint returns 403.
ALLOW_PUBLIC_REGISTRATION=false

# ==== Platform superadmin (used by `python seed.py`) ====
# The platform operator's own login — the only role that can reach
# /api/organizations to onboard, suspend or delete customer companies. No
# defaults on purpose: set a strong, unique password. Leave both blank to skip.
# The seeder is idempotent and never overwrites an existing account.
SEED_SUPERADMIN_EMAIL=""
SEED_SUPERADMIN_PASSWORD=""

# ----------------------------------------------------------------------------
# NOTE: The platform is multi-tenant. Customer companies are provisioned by the
# platform superadmin via
#   POST /api/organizations  { name, admin_email, admin_password, … }
# which creates the organization and its first admin in one transaction. Where
# ALLOW_PUBLIC_REGISTRATION=true, a company can instead self-register via
#   POST /api/auth/register  { email, password, org_name }
# Additional staff are added by that company's admin via POST /api/auth/users.
# Every tenant's data is isolated by org — superadmins included: they manage
# companies, they do not see their fleet data.
