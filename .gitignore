# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Python / backend
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.env
.env.local
.env.prod
*.db
*.sqlite
*.sqlite3

# Frontend env
frontend/.env
frontend/.env.local

# Deprecated — remove when verified
_deprecated/

# Test / coverage artifacts
coverage/
.coverage
.pytest_cache/
htmlcov/

# Build artifacts / binaries (distribute via releases, not VCS)
*.apk
*.aab
**/android/app/build/
**/ios/build/

# Android release signing — NEVER commit the keystore or its credentials.
# (debug.keystore is the universal Android default and is intentionally kept.)
*.keystore
!**/debug.keystore
keystore.properties

# Backend virtualenv (regenerable)
backend/venv/
backend/.venv/

# TypeScript incremental build cache (regenerable)
frontend/*.tsbuildinfo

# Playwright E2E artifacts (traces, screenshots, videos, HTML report)
frontend/test-results/
frontend/playwright-report/
frontend/blob-report/
frontend/.playwright/

# Exported web build + recorded walkthrough video (regenerable, and large)
mobile/dist/
mobile/demo-video/
