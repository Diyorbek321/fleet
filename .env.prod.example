# Copy to .env.prod and fill in. KEEP .env.prod OUT OF GIT (already gitignored).
#   cp .env.prod.example .env.prod

# ── Domains ──────────────────────────────────────────────────────────────────
# Point DNS A records for BOTH at the droplet's public IP before deploying.
# Caddy uses these to obtain Let's Encrypt certificates automatically.
APP_DOMAIN=app.yourdomain.uz
API_DOMAIN=api.yourdomain.uz

# ── Postgres ─────────────────────────────────────────────────────────────────
POSTGRES_USER=fleet
POSTGRES_PASSWORD=        # REQUIRED — set a long random value
POSTGRES_DB=fleet

# ── JWT ──────────────────────────────────────────────────────────────────────
# REQUIRED. Generate: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=

# ── GPS device ingestion ─────────────────────────────────────────────────────
# Comma-separated API keys accepted at /api/gps endpoints.
GPS_API_KEYS=

# ── GPS history retention ────────────────────────────────────────────────────
# truck_location_history is the only table that grows without bound: one row per
# position ping. A driver's phone pings every 15s, so one truck driving 10h/day
# writes ~2 400 rows/day and a 20-truck fleet ~1.4M rows/month. A background job
# deletes anything older than this.
#
# Analytics windows are clamped to this value, so it is also the longest leakage
# report the platform can honestly produce — raising it costs disk, lowering it
# costs history. 90 days covers the 30-day default window plus quarter-end
# review. Set to 0 to keep everything forever (disk becomes your deadline).
GPS_HISTORY_RETENTION_DAYS=90
# Rows deleted per statement. Batched so the first purge on an already-huge
# table never takes a long lock. Raise only if purges are falling behind.
GPS_PURGE_BATCH_SIZE=10000

# ── Optional: error tracking ─────────────────────────────────────────────────
SENTRY_DSN=

# ── Optional: Telegram customer notifications ────────────────────────────────
# Create a bot via @BotFather → set TELEGRAM_BOT_TOKEN and BOT_USERNAME (without @).
# Register the webhook once (from your laptop, replacing the values):
#   curl "https://api.telegram.org/bot<TOKEN>/setWebhook?url=https://<API_DOMAIN>/api/telegram/webhook&secret_token=<SECRET>"
# Leave TELEGRAM_BOT_TOKEN empty to disable the feature entirely (webhook
# returns 404, no daily job runs).
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=
# Hour of day (UTC, 0-23) for the daily "where is my cargo" digest. Uzbekistan
# is UTC+5, so 3 = 08:00 local.
TELEGRAM_DAILY_HOUR_UTC=3
