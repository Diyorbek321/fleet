# Copy to .env.prod and fill in. KEEP .env.prod OUT OF GIT (already gitignored).
#   cp .env.prod.example .env.prod

# ── Domains ──────────────────────────────────────────────────────────────────
# Point DNS A records for BOTH at the droplet's public IP before deploying.
# Caddy uses these to obtain Let's Encrypt certificates automatically.
APP_DOMAIN=app.yourdomain.uz
API_DOMAIN=api.yourdomain.uz

# ── Postgres ─────────────────────────────────────────────────────────────────
POSTGRES_USER=fleet
POSTGRES_PASSWORD=        # REQUIRED — set a long random value
POSTGRES_DB=fleet

# ── JWT ──────────────────────────────────────────────────────────────────────
# REQUIRED. Generate: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=

# ── GPS device ingestion ─────────────────────────────────────────────────────
# Comma-separated API keys accepted at /api/gps endpoints.
GPS_API_KEYS=

# ── Optional: error tracking ─────────────────────────────────────────────────
SENTRY_DSN=
